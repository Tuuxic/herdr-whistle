{
  "_help": "Whistle's defaults: an update replaces this file. Put yours in whistle.json in Herdr's home, over these and over the layout's whistle block; docs/guide.md (Your config) says how.",
  "enabled": true,
  "hints": true,
  "keys": {
    "field-left": ["ctrl-h"],
    "field-down": ["ctrl-j"],
    "field-up": ["ctrl-k"],
    "field-right": ["ctrl-l"],
    "left": ["h", "left"],
    "down": ["j", "down"],
    "up": ["k", "up"],
    "right": ["l", "right"],
    "pick": ["enter"],
    "type": ["i"],
    "cancel": ["escape", "ctrl-["]
  },
  "map": {
    "/": ["Go to tab or space", "mod.open:picker"],
    "p": ["Command palette", "app.palette"],
    "?": ["Keys", "app.help"],
    ",": ["Settings", "app.settings"],
    "+": ["Zoom in", "app.zoom_in"],
    "-": ["Zoom out", "app.zoom_out"],
    "0": ["Reset zoom", "app.zoom_reset"],
    "tab": ["Next tab", "tab.next"],
    "shift-tab": ["Previous tab", "tab.prev"],
    "]": ["Next agent", "agent.next"],
    "[": ["Previous agent", "agent.prev"],
    "b": ["Sidebar", "layout.toggle:sidebar"],
    "L": ["Next layout", "layout.switch"],
    "ctrl-n": ["New tab", "tab.new", null, "type"],
    "f": ["Find in the terminal", "terminal.search", null, "type"],
    "ctrl-u": ["Scroll up half a page", "terminal.scroll", { "pages": -0.5 }],
    "ctrl-d": ["Scroll down half a page", "terminal.scroll", { "pages": 0.5 }],
    "g": ["Scroll to the top", "terminal.scroll", { "to": "top" }],
    "G": ["Scroll to the bottom", "terminal.scroll", { "to": "bottom" }],
    "s": {
      "name": "Spaces",
      "map": {
        "n": ["New space", "space.new", null, "type"],
        "x": ["Close space", "space.close"],
        "r": ["Rename space", "space.rename"]
      }
    },
    "t": {
      "name": "Tabs",
      "map": {
        "n": ["New tab", "tab.new", null, "type"],
        "x": ["Close tab", "tab.close"],
        "r": ["Rename tab", "tab.rename"]
      }
    },
    "w": {
      "name": "Panes",
      "map": {
        "v": ["Split right", "pane.split", { "direction": "right" }, "type"],
        "s": ["Split down", "pane.split", { "direction": "down" }, "type"],
        "q": ["Close pane", "pane.close"],
        "z": ["Zoom pane", "pane.zoom"],
        "H": ["Swap left", "pane.swap", { "direction": "left" }],
        "J": ["Swap down", "pane.swap", { "direction": "down" }],
        "K": ["Swap up", "pane.swap", { "direction": "up" }],
        "L": ["Swap right", "pane.swap", { "direction": "right" }]
      }
    },
    "a": {
      "name": "Agents",
      "map": {
        "n": ["Next agent", "agent.next"],
        "p": ["Previous agent", "agent.prev"]
      }
    }
  }
}
